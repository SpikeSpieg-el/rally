[resource]
script = ExtResource("1_profile")
id = "asphalt"
display_name = "АСФАЛЬТ · ТРЕК"
description = "Гладкое и широкое асфальтовое полотно: почти нет кочек, высокое сцепление, но и скорость выше. Настоящий трек посреди леса."
