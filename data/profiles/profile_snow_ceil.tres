[resource]
script = ExtResource("1_profile")
id = "snow_profile"
display_name = "СНЕЖНАЯ ЦЕЛИНА"
description = "Полотно укрыто снегом: светлое, скользкое, с плотным накатом. Снег меняет и грунт вокруг, поэтому трасса выглядит по-зимнему даже без снегопада."
