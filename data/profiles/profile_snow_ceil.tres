road_width_scale = 0.95
shoulder_scale = 1.20
bumps_scale = 1.25
camber_scale = 1.00
grip_scale = 0.58
rolling_resistance_scale = 1.80
offroad_grip_scale = 0.70
override_road_colors = true
road_color = Color(0.78, 0.82, 0.88, 1)
road_color_2 = Color(0.90, 0.93, 0.97, 1)
shoulder_color = Color(0.72, 0.76, 0.82, 1)
hills_scale = 0.80
