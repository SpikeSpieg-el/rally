[resource]
script = ExtResource("track")
id = "england_dark_valley"
display_name = "ЧЁРНАЯ ДОЛИНА · АНГЛИЯ"
description = "Ночной английский спецучасток: мокрый гравий вперемешку с узким асфальтом, малый дубовый мост над ледяной рекой, потом длинный пологий подъём серпантинами к большому каменному мосту в две арки. Слепые гребни, перепады и плотный лес по обе стороны — ошибка стоит кузова."
