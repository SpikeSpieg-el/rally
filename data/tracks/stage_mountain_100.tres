[resource]
script = ExtResource("track")
id = "mountain_100"
display_name = "ВЕРШИНА • 100 КМ"
description = "Экстремальный горный марафон: 63 разворота серпантина, сотни сложных связок, подъём от долины к снежному перевалу около 2400 м и затяжной спуск. 11 участков: гравий, грязь, асфальт и снег. Полотно сужается до 4,8 м. Погода меняется по маршруту: солнце, дождь, гроза, туман, снег и прояснение. Условия этого этапа задаются маршрутом."
surface_name = "Гравий / грязь / асфальт / снег"
difficulty = 5
target_time = 7200.0
road_curve = ExtResource("curve")
road_half_width = 4.6
road_shoulder = 0.8
road_step = 2.5
road_camber = 0.05
route_sections = Array[ExtResource("section")]([SubResource("Section_0"), SubResource("Section_1"), SubResource("Section_2"), SubResource("Section_3"), SubResource("Section_4"), SubResource("Section_5"), SubResource("Section_6"), SubResource("Section_7"), SubResource("Section_8"), SubResource("Section_9"), SubResource("Section_10")])
stream_world = true
terrain_margin = 70.0
terrain_cell = 6.0
terrain_seed = 1002400
hills_height = 24.0
ridge_height = 38.0
max_terrain_slope_deg = 42.0
embankment_max_width = 38.0
bumps_amplitude = 0.0
bumps_roughness = 0.0
use_baked_props = false
procedural_scenery = true
scenery_density = 0.12
checkpoint_interval = 800.0
fog_near = 80.0
fog_far = 380.0
