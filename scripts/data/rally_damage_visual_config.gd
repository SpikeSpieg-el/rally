## Повреждения кузова: когда мять, как мять и какие следы оставлять на краске.
##
## Ресурс res://data/car/default_damage_visual.tres — правится в инспекторе:
## либо у корня RallyCar в сцене машины (поле `damage_visual_config`),
## либо прямо в файле ресурса (FileSystem → data/car/). Подставьте машине свой
## экземпляр ресурса — и у неё будут свои вмятины.
##
## Система косметическая: ни одно поле не влияет на здоровье, урон, очки
## и физику машины.
@tool
class_name RallyDamageVisualConfig
extends Resource

@export_group("Включение")
## Главный выключатель вмятин и следов на кузове.
@export var enabled: bool = true
## Машины, на которых система работает (vehicle_id из data/vehicles/*.tres).
## Пустой список — на всех машинах: нужен только меш в группе rally_body_fx.
@export var vehicle_ids: Array[String] = []
## Машины, которым вмятины выключены даже при пустом списке выше.
@export var excluded_vehicle_ids: Array[String] = []
## Общая громкость деформации: 1.0 — подобрано под аркадный вид, 0.0 — вмятин нет.
@export_range(0.0, 3.0, 0.05) var dent_scale: float = 1.0
## Запас глубины вмятин на весь кузов, м (сумма глубин всех ударов). Когда
## исчерпан, новые удары геометрию не меняют — остаются только следы на краске.
@export_range(0.1, 20.0, 0.05, "suffix:м") var dent_budget_m: float = 4.0

@export_group("Когда мять")
## Потеря скорости за кадр физики, м/с, с которой удар достоин вмятины.
## Порог урона в настройках аркады (crash_min_dv_mps) — 4.6 м/с: вмятина
## должна появляться раньше урона, иначе лёгкие касания выглядят безнаказанными.
@export_range(0.5, 12.0, 0.1, "suffix:м/с") var min_dv_mps: float = 2.2
## Пауза между вмятинами, с. Длинное касание вдоль забора даёт серию заломов,
## а не сотни вмятин за один кадр контакта.
@export_range(0.05, 2.0, 0.05, "suffix:с") var cooldown_sec: float = 0.2
## Вертикальная составляющая нормали контакта, выше которой контакт у днища
## считается грунтом и кузов не мнёт. Меньше — строже отсев (приземления и
## кочки не мнут), больше — мягче.
@export_range(0.1, 1.0, 0.05) var ground_normal_y: float = 0.55
## Мять крышу и верх кузова при опрокидывании: контакт выше этой доли высоты
## кузова мнёт его, даже если нормаль вертикальная. 1.0 — выключено.
@export_range(0.3, 1.0, 0.05) var roof_contact_height: float = 0.62
## Брать силу удара из импульса контакта (точнее на скользящих ударах).
## Выключено — только из потери скорости кузова, как раньше.
@export var use_contact_impulse: bool = true
## Сколько контактов записывать физике. На решение солвера запись не влияет.
@export_range(1, 32, 1) var max_contacts: int = 8

@export_group("Сетка кузова")
## Сгустить сетку кузова перед первым ударом. Низкополигональная панель
## (дверь или капот из двух треугольников) иначе мнётся острым «шипом» и
## перекошенными треугольниками. Внешний вид целой машины не меняется:
## новые вершины лежат строго на старых гранях.
@export var subdivide_enabled: bool = true
## Рёбра длиннее этого делятся пополам, м. Меньше — плавнее вмятины, но больше
## вершин и дольше пересчёт удара.
@export_range(0.06, 1.0, 0.01, "suffix:м") var subdivide_max_edge_m: float = 0.2
## Сколько раз подряд делить рёбра (каждый проход — вдвое короче).
@export_range(0, 8, 1) var subdivide_max_passes: int = 5
## Потолок вершин на одну поверхность: дальше сетка не сгущается.
@export_range(1000, 200000, 1000) var subdivide_vertex_limit: int = 40000

@export_group("Форма вмятины")
## Прирост глубины на каждый м/с потерянной скорости, м на м/с.
@export_range(0.001, 0.080, 0.001) var depth_per_dv_m: float = 0.016
## Пол и потолок глубины одной вмятины, м.
@export_range(0.005, 0.200, 0.005, "suffix:м") var depth_min_m: float = 0.035
@export_range(0.02, 0.80, 0.01, "suffix:м") var depth_max_m: float = 0.30
## Радиус вмятины, м: базовый, прирост на каждый м/с и потолок.
@export_range(0.05, 1.50, 0.01, "suffix:м") var radius_base_m: float = 0.40
@export_range(0.000, 0.150, 0.001) var radius_per_dv_m: float = 0.030
@export_range(0.10, 2.50, 0.01, "suffix:м") var radius_max_m: float = 0.95
## Насколько глубоко внутрь кузова уходит смятие, в радиусах вмятины. Удар в
## бампер сминает и край капота за ним — это и делает нос «гармошкой».
@export_range(0.2, 3.0, 0.05) var crush_depth_scale: float = 1.25
## Глубина не больше этой доли радиуса: иначе треугольники в центре
## складываются пополам и выворачиваются.
@export_range(0.1, 1.0, 0.05) var max_strain: float = 0.55
## Предел смещения одной вершины за все удары, м: силуэт не проваливается
## внутрь салона.
@export_range(0.05, 1.5, 0.01, "suffix:м") var max_vertex_offset_m: float = 0.5
## Вспученный край: доля глубины, которая уходит наружу у кромки вмятины.
@export_range(0.0, 0.8, 0.02) var rim_bulge: float = 0.18
## Ширина вспученного края, доля радиуса.
@export_range(0.05, 0.8, 0.01) var rim_width: float = 0.3
## Волны-заломы вдоль удара (капот «гармошкой»): доля глубины.
@export_range(0.0, 1.0, 0.02) var buckle_amount: float = 0.24
## Длина волны залома, м.
@export_range(0.08, 1.5, 0.01, "suffix:м") var buckle_wavelength_m: float = 0.42
## Плавное «жевание» металла: доля глубины. Шум зависит только от положения
## точки, поэтому совпадающие вершины соседних треугольников едут одинаково —
## швов и разрывов нет.
@export_range(0.0, 1.0, 0.02) var crumple_amount: float = 0.22
## Размер складок шума, м. Меньше — мельче рябь (нужна густая сетка).
@export_range(0.05, 1.5, 0.01, "suffix:м") var crumple_scale_m: float = 0.28
## Насколько далеко от точки контакта искать поверхность кузова, м. Коллизия
## машины — выпуклая оболочка, и контакт приходит не точно на краску.
@export_range(0.1, 2.0, 0.05, "suffix:м") var surface_search_m: float = 0.8
## Двигать вместе с панелью мелкие детали, прикреплённые к ней (выхлоп,
## антенны, фары-дочки меша кузова), чтобы они не висели в воздухе над вмятиной.
@export var follow_attached_parts: bool = true

@export_group("Следы на кузове")
## Царапины, сколы краски и копоть в месте удара и вдоль скольжения по забору.
@export var marks_enabled: bool = true
## Сколько следов помнит кузов одновременно (старые затираются новыми).
@export_range(1, 16, 1) var marks_max: int = 16
## Сила следа на каждый м/с удара; 1.0 — полностью проявленный след.
@export_range(0.01, 0.5, 0.01) var mark_strength_per_dv: float = 0.11
## Минимальная сила следа от удара.
@export_range(0.0, 1.0, 0.05) var mark_strength_min: float = 0.35
## Радиус следа относительно радиуса вмятины.
@export_range(0.3, 3.0, 0.05) var mark_radius_scale: float = 1.1
## Копоть и тёмный залом в центре сильного удара: 0 — нет.
@export_range(0.0, 1.0, 0.05) var mark_soot: float = 0.55
## Скольжение по забору: с какой скорости вдоль стены появляется царапина, м/с.
@export_range(0.5, 20.0, 0.5, "suffix:м/с") var scrape_min_speed_mps: float = 3.0
## Как быстро проявляется царапина при скольжении, в секунду.
@export_range(0.1, 10.0, 0.1) var scrape_growth_per_sec: float = 2.2
## Радиус царапины от скольжения, м.
@export_range(0.05, 1.0, 0.01, "suffix:м") var scrape_radius_m: float = 0.22
## Цвет грунта под краской.
@export var primer_color: Color = Color(0.58, 0.58, 0.55, 1)
## Цвет голого металла в глубоких царапинах.
@export var metal_color: Color = Color(0.78, 0.79, 0.81, 1)
## Цвет копоти и тёмного залома.
@export var soot_color: Color = Color(0.05, 0.045, 0.04, 1)
## Блеск голого металла (0 — матовый).
@export_range(0.0, 1.0, 0.05) var metal_gloss: float = 0.7
## Частота штрихов царапин, на метр: больше — тоньше штрихи.
@export_range(10.0, 300.0, 1.0) var scratch_frequency: float = 70.0
## Общая непрозрачность следов.
@export_range(0.0, 1.0, 0.05) var marks_opacity: float = 0.95


## Работает ли система на машине с этим id.
func applies_to(vehicle_id: String) -> bool:
	if not enabled:
		return false
	if excluded_vehicle_ids.has(vehicle_id):
		return false
	return vehicle_ids.is_empty() or vehicle_ids.has(vehicle_id)
