## Визуальные повреждения кузова: когда мять, насколько глубоко и на каких
## машинах система включена.
##
## Раньше эти числа были константами в rally_car.gd, а часть — полями компонента,
## который создаётся кодом и в редакторе не виден. Теперь это ресурс
## res://data/car/default_damage_visual.tres — правится в инспекторе:
## либо у корня RallyCar в сцене машины (поле `damage_visual_config`),
## либо прямо в файле ресурса (FileSystem → data/car/).
##
## Система косметическая: ни одно поле не влияет на здоровье, урон, очки
## и физику машины.
@tool
class_name RallyDamageVisualConfig
extends Resource

@export_group("Включение")
## Главный выключатель вмятин.
@export var enabled: bool = true
## Машины, на которых система работает (vehicle_id из data/vehicles/*.tres).
## Пробный запуск — только Lancer; допишите id, чтобы включить на другой машине.
@export var vehicle_ids: Array[String] = ["mitsubishi"]
## Общая громкость деформации: 1.0 — подобрано под аркадный вид, 0.0 — вмятин нет.
@export_range(0.0, 3.0, 0.05) var dent_scale: float = 1.0
## Запас глубины вмятин на весь кузов, м. Когда исчерпан, новые удары геометрию
## не меняют: машина не превращается в бесформенную кашу и не теряет силуэт.
@export_range(0.1, 4.0, 0.05, "suffix:м") var dent_budget_m: float = 1.1

@export_group("Когда мять")
## Потеря скорости за кадр физики, м/с, с которой удар достоин вмятины.
## Порог урона в настройках аркады (crash_min_dv_mps) — 4.6 м/с: вмятина
## должна появляться раньше урона, иначе лёгкие касания выглядят безнаказанными.
@export_range(0.5, 12.0, 0.1, "suffix:м/с") var min_dv_mps: float = 2.2
## Пауза между вмятинами, с. Длинное касание вдоль забора даёт серию заломов,
## а не сотни вмятин за один кадр контакта.
@export_range(0.05, 2.0, 0.05, "suffix:с") var cooldown_sec: float = 0.25
## Вертикальная составляющая нормали контакта, выше которой контакт считается
## грунтом, поребриком или крышей и кузов не мнёт. Меньше значение — строже
## отсев (приземления и кочки не мнут), больше — мягче.
@export_range(0.1, 1.0, 0.05) var ground_normal_y: float = 0.55
## Сколько контактов записывать физике. Запись включается только на машинах
## из списка выше; на решение солвера она не влияет.
@export_range(1, 32, 1) var max_contacts: int = 8

@export_group("Форма вмятины")
## Прирост глубины на каждый м/с потерянной скорости, м на м/с.
@export_range(0.001, 0.060, 0.001) var depth_per_dv_m: float = 0.012
## Пол и потолок глубины одной вмятины, м.
@export_range(0.005, 0.100, 0.005, "suffix:м") var depth_min_m: float = 0.02
@export_range(0.02, 0.50, 0.01, "suffix:м") var depth_max_m: float = 0.16
## Радиус вмятины, м: базовый, прирост на каждый м/с и потолок.
@export_range(0.05, 1.00, 0.01, "suffix:м") var radius_base_m: float = 0.32
@export_range(0.000, 0.100, 0.001) var radius_per_dv_m: float = 0.024
@export_range(0.10, 1.50, 0.01, "suffix:м") var radius_max_m: float = 0.62
## Вспученный край: доля глубины, которая уходит наружу у кромки вмятины.
## Ноль — аккуратная гладкая воронка, больше — заметный залом, как на BeamNG.
@export_range(0.0, 0.8, 0.02) var rim_bulge: float = 0.30
## Складки металла поперёк направления удара: доля глубины.
@export_range(0.0, 1.0, 0.02) var crumple_amount: float = 0.38
## Мелкий шум «жевания» металла: доля глубины.
@export_range(0.0, 0.50, 0.01) var jitter_amount: float = 0.10
## Во сколько раз шире пробовать радиус, если у низкополигональной панели рядом
## с ударом не оказалось ни одной вершины. Меньше 1.0 — повторная попытка
## отключена.
@export_range(1.0, 4.0, 0.1) var retry_radius_scale: float = 2.0
