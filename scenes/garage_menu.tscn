[ext_resource type="PackedScene" path="res://scenes/garage_showroom.tscn" id="showroom_scene"]
[ext_resource type="Shader" path="res://shaders/speed_fx.gdshader" id="ps1_shader"]

[sub_resource type="ShaderMaterial" id="ShowroomPS1Material"]
