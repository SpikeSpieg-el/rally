[sub_resource type="GDScript" id="GDScript_cockpit"]
script/source = "extends Node3D\n\n## Кокпит Subaru Impreza WRX STI: своя геометрия салона и свои приборы.\n## Общий каркас управления (руль, педали, ручник, кулиса, табло) тот же,\n## что в кокпите Mitsubishi, но размеры, посадка и оформление — под Impreza:\n## руль ближе и ниже, сиденья плотнее (узкий салон), кузов WR Blue с\n## характерной жёлто-чёрной окантовкой приборов STI.\n\n@export var max_steering_wheel_angle_deg: float = 360.0\n@export var steer_smooth_speed: float = 12.0\n## Порог включения блинкеров переключения, об/мин (у EJ25 отсечка 6800).\n@export var shift_light_from_rpm: float = 5100.0\n@export var shift_light_to_rpm: float = 6800.0\n\nvar _car: RigidBody3D\nvar _current_steer: float = 0.0\nvar _last_gear: String = \"N\"\nvar _shifter_kick: float = 0.0\n\n@onready var steering_pivot: Node3D = $Dashboard/SteeringColumn/SteeringWheelPivot\n@onready var handbrake_pivot: Node3D = $Controls/HandbrakeBase/HandbrakePivot\n@onready var shifter_pivot: Node3D = $Controls/ShifterBase/ShifterPivot\n@onready var pedal_gas: Node3D = $Controls/PedalBox/PedalGasPivot\n@onready var pedal_brake: Node3D = $Controls/PedalBox/PedalBrakePivot\n@onready var pedal_clutch: Node3D = $Controls/PedalBox/PedalClutchPivot\n@onready var gear_label: Label3D = $Dashboard/MotecDisplay/GearLabel\n@onready var speed_label: Label3D = $Dashboard/MotecDisplay/SpeedLabel\n@onready var rpm_label: Label3D = $Dashboard/MotecDisplay/RPMLabel\n@onready var shift_lights: Node3D = $Dashboard/MotecDisplay/ShiftLights\n\n\nfunc _ready() -> void:\n\tvar p: Node = get_parent()\n\twhile p != null:\n\t\tif p is RigidBody3D:\n\t\t\t_car = p\n\t\t\tbreak\n\t\tp = p.get_parent()\n\n\nfunc _process(delta: float) -> void:\n\t# 1. Руль. У Impreza баранка короче хода, чем у Lancer.\n\tvar steer_input: float = 0.0\n\tif _car and \"steering_input\" in _car:\n\t\tsteer_input = float(_car.get(\"steering_input\"))\n\telif InputMap.has_action(\"steer_left\") and InputMap.has_action(\"steer_right\"):\n\t\tsteer_input = Input.get_axis(\"steer_right\", \"steer_left\")\n\tvar steer_weight: float = clampf(delta * steer_smooth_speed, 0.0, 1.0)\n\t_current_steer = lerp(_current_steer, steer_input, steer_weight)\n\tif steering_pivot:\n\t\tsteering_pivot.rotation.z = deg_to_rad(\n\t\t\t-_current_steer * (max_steering_wheel_angle_deg * 0.5)\n\t\t)\n\n\t# 2. Педали, сцепление и ручник.\n\tvar throttle: float = 0.0\n\tvar brake: float = 0.0\n\tvar clutch: float = 0.0\n\tvar handbrake: float = 0.0\n\tif _car:\n\t\tthrottle = float(_car.get(\"throttle_input\")) if \"throttle_input\" in _car else 0.0\n\t\tbrake = float(_car.get(\"brake_input\")) if \"brake_input\" in _car else 0.0\n\t\tclutch = float(_car.get(\"clutch_input\")) if \"clutch_input\" in _car else 0.0\n\t\thandbrake = float(_car.get(\"handbrake_input\")) if \"handbrake_input\" in _car else 0.0\n\tif pedal_gas:\n\t\tvar gas_target: float = deg_to_rad(throttle * 18.0)\n\t\tpedal_gas.rotation.x = lerp(pedal_gas.rotation.x, gas_target, delta * 15.0)\n\tif pedal_brake:\n\t\tvar brake_target: float = deg_to_rad(brake * 14.0)\n\t\tpedal_brake.rotation.x = lerp(pedal_brake.rotation.x, brake_target, delta * 15.0)\n\tif pedal_clutch:\n\t\tvar clutch_target: float = deg_to_rad(clutch * 16.0)\n\t\tpedal_clutch.rotation.x = lerp(pedal_clutch.rotation.x, clutch_target, delta * 15.0)\n\tif handbrake_pivot:\n\t\tvar handbrake_target: float = deg_to_rad(-handbrake * 24.0)\n\t\thandbrake_pivot.rotation.x = lerp(\n\t\t\thandbrake_pivot.rotation.x, handbrake_target, delta * 14.0\n\t\t)\n\n\t# 3. Приборы.\n\tvar speed_kmh: float = 0.0\n\tvar rpm: float = 0.0\n\tvar gear_str: String = \"N\"\n\tif _car:\n\t\tspeed_kmh = _car.linear_velocity.length() * 3.6\n\t\tif \"engine_rpm\" in _car:\n\t\t\trpm = float(_car.get(\"engine_rpm\"))\n\t\telif \"current_rpm\" in _car:\n\t\t\trpm = float(_car.get(\"current_rpm\"))\n\t\tif \"current_gear\" in _car:\n\t\t\tgear_str = str(_car.get(\"current_gear\"))\n\n\tif gear_str != _last_gear:\n\t\t_last_gear = gear_str\n\t\t_shifter_kick = 1.0\n\t_shifter_kick = move_toward(_shifter_kick, 0.0, delta * 6.0)\n\tif shifter_pivot:\n\t\tshifter_pivot.rotation.x = deg_to_rad(-_shifter_kick * 12.0)\n\n\tif gear_label:\n\t\tgear_label.text = gear_str\n\tif speed_label:\n\t\tspeed_label.text = \"%03d KM/H\" % int(round(speed_kmh))\n\tif rpm_label:\n\t\trpm_label.text = \"%04d RPM\" % int(round(rpm))\n\n\t# 4. Блинкеры: у боксера отсечка ниже, поэтому и порог другой.\n\tif shift_lights:\n\t\tvar ratio: float = inverse_lerp(shift_light_from_rpm, shift_light_to_rpm, rpm)\n\t\tvar count: int = shift_lights.get_child_count()\n\t\tfor i in range(count):\n\t\t\tvar led := shift_lights.get_child(i) as MeshInstance3D\n\t\t\tif led:\n\t\t\t\tled.visible = ratio >= float(i + 1) / float(count)\n"

