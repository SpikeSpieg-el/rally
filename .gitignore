# проекта на другой версии/платформе (битые UID, .ctex, shader cache).
.godot/

# Экспорт и временные файлы
*.tmp
*.bak
*.import.tmp
export/
build/
.DS_Store
Thumbs.db

# Python-кэш инструментов авторинга
tools/__pycache__/
